---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = await getCollection('projects', ({ data }) => !data.hidden);

// Sort: explicit order first, then by year descending
projects.sort((a, b) => {
  const orderA = a.data.order ?? Infinity;
  const orderB = b.data.order ?? Infinity;
  if (orderA !== orderB) return orderA - orderB;
  const yearA = a.data.year ?? '';
  const yearB = b.data.year ?? '';
  return yearB.localeCompare(yearA);
});
---

<BaseLayout title="paige tambornino" pageType="index">
  <section class="archive">
    <ul class="archive-list">
      {projects.map((project) => (
        <li class="archive-item">
          <a href={`/projects/${project.id}`}>
            <span class="archive-title">{project.data.title}</span>
          </a>
          {project.data.year && (
            <span class="archive-year">{project.data.year}</span>
          )}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
