      <p>I don't have much to say about myself right now.</p>
      <p>Born in [Minneapolis]. Lives and works in [Chicago].</p>
      <p>M.Arch, [The University of Illinois Chicago], [current].</p>
      <p>
  <a href="mailto:paige.tambornino@gmail.com">paige.tambornino@gmail.com</a><br />
  <a href="https://instagram.com/tambbo" rel="tambbo">Instagram</a><br />
  <a href="https://www.are.na/p-t-13ugvzlwbkm/index" target="_blank" rel="noopener noreferrer">Are.na</a>
     </p>
    </div>
 
    <div class="text-divider" aria-hidden="true">¸,ø¤°`°¤ø,¸¸,ø¤°`°¤ø,¸¸,ø¤°`°¤ø,¸¸,ø¤°`°¤ø,¸¸,ø¤°`°¤ø,¸¸,ø¤°`°¤ø,¸¸,ø¤°`°¤ø,¸¸,ø¤°`°¤ø,¸¸,ø¤°`°¤ø,¸¸,ø¤°`°¤ø,¸</div>
 
    {postsWithContent.length > 0 && (
      <div class="text-feed">
        {postsWithContent.map(({ post, Content, hasBody }) => (
          <article class="text-post">
            <p class="text-post-date">{post.data.date}</p>
            <h2 class="text-post-title">
              {post.data.link ? (
                <a href={post.data.link} target="_blank" rel="noopener noreferrer">
                  {post.data.title} <span class="text-post-arrow" aria-hidden="true">↗</span>
                </a>
              ) : (
                post.data.title
              )}
            </h2>
            {post.data.image && (
              <div class="text-post-image" style={post.data.image_width ? `max-width: ${post.data.image_width}` : undefined}>
                <img src={post.data.image} alt={post.data.title} loading="lazy" />
              </div>
            )}
            {hasBody && (
              <div class="text-post-body">
                <Content />
              </div>
            )}
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
 
