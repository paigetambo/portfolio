---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Info" pageType="info">
  <section class="info">
    <div class="info-body">
      <p>
        A short biography goes here. Two or three sentences about you, what you make,
        where you're based. Keep it spare — the work does the heavy lifting.
      </p>

      <p>
        Born in <em>Place</em>. Lives and works in <em>City</em>.
        Holds an <em>MFA / BFA / degree</em> from <em>Institution</em>.
      </p>

      <h2>Selected exhibitions</h2>
      <p>
        2025 — <em>Exhibition Title</em>, Gallery Name, City<br />
        2024 — <em>Exhibition Title</em>, Gallery Name, City<br />
        2023 — <em>Exhibition Title</em>, Gallery Name, City
      </p>

      <h2>Press</h2>
      <p>
        2025 — <em>Article Title</em>, Publication Name<br />
        2024 — <em>Article Title</em>, Publication Name
      </p>

      <h2>Contact</h2>
      <p>
        <a href="mailto:hello@example.com">hello@example.com</a><br />
        <a href="https://instagram.com/yourhandle" rel="me">Instagram</a>
      </p>
    </div>
  </section>
</BaseLayout>
