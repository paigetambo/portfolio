---
import '../styles/global.css';
 
interface Props {
  title?: string;
  description?: string;
  pageType?: 'index' | 'project' | 'text' | 'process';
}
 
const {
  title = 'Paige Tambornino',
  description = 'Portfolio of work',
  pageType = 'index',
} = Astro.props;
 
const fullTitle = pageType === 'index' ? title : `${title} — Paige Tambornino`;
const currentPath = Astro.url.pathname;
const isTextActive = currentPath === '/text' || currentPath === '/text/';
const isProcessActive = currentPath === '/process' || currentPath === '/process/';
const isProjectsActive = !isTextActive && !isProcessActive;
---
 
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <p class="site-title">
        <a href="/">Paige Tambornino</a>
      </p>
      <nav class="site-nav" aria-label="Primary">
        <a href="/" class={isProjectsActive ? 'active' : ''}>Projects</a>
        <a href="/process" class={isProcessActive ? 'active' : ''}>Process</a>
        <a href="/text" class={isTextActive ? 'active' : ''}>Text</a>
      </nav>
    </header>
 
    <main>
      <slot />
    </main>
 
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Paige Tambornino</p>
    </footer>
  </body>
</html>
 
